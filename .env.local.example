# AI API 키 (하나 이상 설정)
# OpenRouter 권장 — 하나의 키로 Claude, GPT 등 여러 모델 사용 가능
OPENROUTER_API_KEY=sk-or-xxxxx

# NVIDIA DeepSeek fallback을 로컬에서 테스트할 때만 설정
# NVIDIA_API_KEY=nvapi-xxxxx

# 앱 URL (OpenRouter Referer용)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 배포 변형
# default: 기본 청렴 앱, plus: 존중 파일럿 포함, student: 청소년 교육용
NEXT_PUBLIC_APP_VARIANT=default
NEXT_PUBLIC_ENABLE_RESPECT_PILOT=0
NEXT_PUBLIC_ENABLE_AI_CHAT=1

# 관리자 대시보드 접근 비밀번호 (설정 시 /admin/dashboard 접근 제한)
ADMIN_SECRET=your-secret-here
