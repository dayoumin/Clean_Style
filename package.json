{
  "name": "integrity-style-test",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:clean": "rimraf .next && next dev --webpack",
    "build": "next build --webpack && opennextjs-cloudflare build --skipNextBuild",
    "build:html": "node scripts/build-standalone-html.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:node": "node --test scripts/experiments/*.test.mjs scripts/__tests__/*.test.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm test:node",
    "release": "node scripts/release.mjs release",
    "release:rollback": "node scripts/release.mjs rollback",
    "prepare": "node scripts/install-git-hooks.mjs",
    "docs:student-item-bank": "node scripts/generate-student-item-bank.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "clsx": "^2.1.0",
    "next": "16.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "@tailwindcss/node": "4.2.2",
    "@tailwindcss/oxide": "4.2.2",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.27.3",
    "html-to-image": "1.11.13",
    "playwright": "1.58.2",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2",
    "wrangler": "^4.152.0"
  }
}
